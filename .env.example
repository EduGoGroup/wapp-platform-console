# wapp-platform-console — variables de entorno (prefijo WAPP_). Copia a .env y ajusta. Sin secretos aquí:
# la consola no custodia credenciales propias, solo habla con identity (:8200), la API pública (:8103,
# solo para el canje del login) y el listener admin de la plataforma (:8100, loopback/confianza).
#
# Varias variables tienen un alias legado: el código prueba PRIMERO el nombre que aparece primero abajo
# y solo si está ausente cae al alias. Define uno de los dos, no ambos.

# Ambiente lógico: "local" (permisivo, sin TLS) o cualquier otro (endurece Secure cookie + HSTS por
# default). Alias legado: WAPP_PLATFORM_CONSOLE_ENV.
WAPP_CONSOLE_ENV=local

# Dirección de escucha de la consola (host:port). Banda 81xx de wApp. Alias legado: WAPP_CONSOLE_HTTP_ADDR.
WAPP_PLATFORM_CONSOLE_HTTP_ADDR=127.0.0.1:8106

# URL base del listener ADMIN de la plataforma (:8100). Loopback/confianza: aquí viven las operaciones
# de plataforma (tenants, instalaciones, bandeja de acceso). Sin alias.
WAPP_ADMIN_API_BASE=http://127.0.0.1:8100

# URL base de la API pública REST de la plataforma (:8103 /api/v1). Solo se usa para el canje de
# Identity Token → Context Token en el login (POST /api/v1/auth/exchange). Sin alias.
WAPP_PUBLIC_API_BASE=http://127.0.0.1:8103

# URL base de identity-api (:8200), el emisor de Identity Tokens. La consola SIEMPRE autentica vía
# identity con system="wapp.platform" (a diferencia del BFF, aquí no hay modo legado sin identity).
# Sin alias.
WAPP_IDENTITY_URL=http://127.0.0.1:8200

# --- Cookie de sesión (JWT server-side, HttpOnly siempre) ---
# Secure: true en producción (TLS). En local, false. Default: true salvo ENV=local.
WAPP_CONSOLE_COOKIE_SECURE=false
# SameSite: lax | strict | none. "none" obliga Secure=true.
WAPP_CONSOLE_COOKIE_SAMESITE=lax

# --- CORS (fail-closed) ---
# Allowlist CSV de orígenes completos (p. ej. https://plataforma.wapp.test). Vacío == same-origin.
# NUNCA "*".
WAPP_CONSOLE_ALLOWED_ORIGINS=

# --- Proxies de confianza (para resolver la IP real del cliente tras un balanceador) ---
# CSV de IPs/CIDRs. Vacío == sin proxies de confianza (se usa la IP de conexión tal cual).
# Alias legado: WAPP_CONSOLE_TRUSTED_PROXIES.
WAPP_PLATFORM_CONSOLE_TRUSTED_PROXIES=

# --- HSTS ---
# Emite Strict-Transport-Security (solo tiene sentido tras TLS). Default: sigue a COOKIE_SECURE.
WAPP_CONSOLE_HSTS_ENABLED=false

# --- Rate-limit (en memoria, por IP o usuario autenticado) ---
WAPP_CONSOLE_RATE_ENABLED=true
WAPP_CONSOLE_RATE_RPS=5
WAPP_CONSOLE_RATE_BURST=10

# --- Timeouts del http.Server (segundos, anti-slowloris) ---
WAPP_CONSOLE_READ_HEADER_TIMEOUT_SECS=5
WAPP_CONSOLE_READ_TIMEOUT_SECS=15
WAPP_CONSOLE_WRITE_TIMEOUT_SECS=30
WAPP_CONSOLE_IDLE_TIMEOUT_SECS=60

# Plazo (segundos) que se espera al apagado ordenado (SIGINT/SIGTERM) antes de forzar el cierre.
WAPP_CONSOLE_SHUTDOWN_TIMEOUT_SECS=10

# Acota, por petición entrante, la cadena de llamadas a identity/API pública/admin (incluido el
# refresco proactivo de sesión). También fija el http.Client.Timeout de authclient y adminclient.
WAPP_CONSOLE_UPSTREAM_TIMEOUT_SECS=20
